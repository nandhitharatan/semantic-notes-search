# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_URL=postgresql://admin:change_me@localhost:5432/notes_db

# Qdrant connection URL
QDRANT_URL=http://localhost:6333

# Optional Qdrant API key (leave blank for local development without authentication)
QDRANT_API_KEY=
